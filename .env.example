# FINN — Environment Variables
# Copy to .env.local and fill in your keys

# Gemini (FREE — get from ai.google.dev)
GEMINI_API_KEY=your_gemini_key_here

# Anthropic (for deep analysis — optional, only used for Pull mode research)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Groq (FREE alternative to Gemini — get from console.groq.com)
GROQ_API_KEY=your_groq_key_here
